# Editor / OS junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Dependencies & build output (generated — never commit)
node_modules/
# Docusaurus build cache
.docusaurus/
# compiled static site (the deploy rebuilds this from source)
build/

# Local draft content — kept out of the published source tree
_drafts/

# Never commit secrets anywhere in the tree
**/.secrets/
**/.secrets
**/secrets/
*.secret
*.secrets
.secrets.md
.env
.env.*

# Internal marketing/strategy context (mirrors main-repo _internal/ pattern).
# product-marketing-context.md is auto-loaded by marketing skills; stays local
# to avoid any risk of public CDN exposure of internal positioning notes.
.agents/
